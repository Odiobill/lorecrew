{
  "name": "lorecrew",
  "version": "0.1.0-preview.3",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "bin": {
    "lorecrew": "dist/cli.js"
  },
  "scripts": {
    "test": "vitest run",
    "check": "tsc --noEmit && tsc -p tsconfig.web.json",
    "build": "tsc -p tsconfig.build.json && vite build",
    "test:e2e": "playwright test",
    "preview:workspace": "npm run build && tsx tests/helpers/workspace-preview.ts",
    "prepack": "tsc -p tsconfig.build.json && vite build",
    "test:acceptance": "vitest run tests/acceptance",
    "smoke:providers": "node scripts/platform-smoke.mjs --mode providers",
    "smoke:platform": "node scripts/platform-smoke.mjs --mode platform",
    "preview:setup": "npm run build && tsx tests/helpers/setup-preview.ts",
    "preview:skills": "npm run build && tsx tests/helpers/skills-preview.ts",
    "preview:daily": "npm run build && tsx tests/helpers/daily-use-preview.ts",
    "check:public": "node packaging/check-public.mjs",
    "build:site": "node website/build.mjs",
    "test:site": "node --test website/tests/build.test.mjs",
    "test:site:browser": "playwright test --config website/playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.1",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@earendil-works/chord": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-codemode": "1.4.0",
    "@earendil-works/pi-durable": "1.4.0",
    "@hono/node-server": "2.1.5",
    "chokidar": "4.0.3",
    "cron-parser": "5.10.2",
    "hono": "4.13.13",
    "proper-lockfile": "4.1.2",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "typebox": "1.3.27",
    "yaml": "2.9.1"
  },
  "description": "Independent durable local AI teams with a shared knowledge vault",
  "files": [
    "npm-shrinkwrap.json",
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/web/**",
    "packaging/**",
    "docs/getting-started.md",
    "docs/installation.md",
    "docs/configuration.md",
    "docs/agents.md",
    "docs/projects.md",
    "docs/knowledge-and-skills.md",
    "docs/routines.md",
    "docs/multi-device.md",
    "docs/backup-and-recovery.md",
    "docs/security.md",
    "docs/troubleshooting.md",
    "docs/architecture.md",
    "docs/api-and-cli.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Odiobill/lorecrew.git"
  },
  "homepage": "https://odiobill.github.io/lorecrew/",
  "bugs": {
    "url": "https://github.com/Odiobill/lorecrew/issues"
  }
}
